# Copy to .env and run:  node --env-file=.env server/index.js
PORT=3000
# Folder for the SQLite database and uploaded images (must be persistent in production!)
DATA_DIR=./data
# Optional: Gemini key (can also be set from the admin "Settings" screen)
GEMINI_API_KEY=
# Optional: how many devices a student may be logged in on at once (default 2)
MAX_STUDENT_DEVICES=2
# Optional: force secure cookies (auto-detected behind HTTPS proxies)
# COOKIE_SECURE=true
# Dev only: fake AI responses for testing without a key
# AI_MOCK=1
